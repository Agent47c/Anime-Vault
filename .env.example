# AnimeVault Environment Configuration Template
# Copy this file to .env and customize as needed.

# AniList GraphQL API Endpoint
ANILIST_GRAPHQL_URL=https://graphql.anilist.co

# Jikan v4 REST API Endpoint (Fallback)
JIKAN_BASE_URL=https://api.jikan.moe/v4

# Local Read-Only Streaming API
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8765

# Optional API Access Token for Local Streaming API
# Optional for loopback only; required when binding to a LAN/non-loopback host.
# Clients send Authorization: Bearer <token>. Tokens are not accepted in URLs.
API_ACCESS_TOKEN=

# Comma-separated browser origins explicitly allowed to read the API.
# Empty disables cross-origin browser access. Wildcard origins are not accepted.
ALLOWED_API_ORIGINS=

# Force Offline Mode (true/false)
OFFLINE_MODE=false
